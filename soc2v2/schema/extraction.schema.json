{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybercede.com/schemas/soc2-extraction/1.0",
  "title": "SOC 2 Type II Evidence Extraction (model-neutral)",
  "description": "The ONLY thing the AI produces. Every fact carries its own evidence (verbatim quote + page). Deterministic code verifies it; humans decide.",
  "type": "object",
  "required": ["schema_version", "extractor", "source", "report", "subservice_orgs", "cuecs", "controls", "exceptions"],
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["quote", "pdf_page"],
      "properties": {
        "quote": {"type": "string", "description": "Verbatim text copied from the report (10-60 words). Do not paraphrase."},
        "pdf_page": {"type": "integer", "minimum": 1, "description": "1-based page index in the PDF file (the viewer's page number)."},
        "printed_page": {"type": ["integer", "null"], "description": "Page number printed on the page itself, if any."}
      }
    },
    "test": {
      "type": "object",
      "required": ["procedure", "result"],
      "properties": {
        "procedure": {"type": "string"},
        "result": {"enum": ["no_exceptions", "exception", "not_tested", "other"]},
        "result_text": {"type": "string", "description": "Verbatim result wording, e.g. 'No exceptions noted.'"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "extractor": {
      "type": "object",
      "required": ["model", "run_at"],
      "properties": {
        "model": {"type": "string", "description": "e.g. gemini-3-pro, claude-opus-5-5, local llama"},
        "tool": {"type": "string", "description": "e.g. Claude, Gemini, Ollama"},
        "run_at": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": {"type": "string"},
        "sha256": {"type": "string"},
        "page_count": {"type": "integer"}
      }
    },
    "report": {
      "type": "object",
      "required": ["service_org", "system_name", "report_type", "period_start", "period_end", "issue_date", "auditor", "opinion", "tsc_categories_in_scope"],
      "properties": {
        "service_org": {"type": "string"},
        "system_name": {"type": "string"},
        "products_in_scope": {"type": "array", "items": {"type": "string"}},
        "report_type": {"enum": ["SOC 2 Type I", "SOC 2 Type II", "SOC 1 Type I", "SOC 1 Type II", "SOC 3", "other"]},
        "period_start": {"type": "string", "format": "date"},
        "period_end": {"type": "string", "format": "date"},
        "issue_date": {"type": "string", "format": "date"},
        "auditor": {"type": "string"},
        "opinion": {
          "type": "object",
          "required": ["type", "evidence"],
          "properties": {
            "type": {"enum": ["unqualified", "qualified", "adverse", "disclaimer"]},
            "evidence": {"$ref": "#/$defs/evidence"}
          }
        },
        "tsc_categories_in_scope": {"type": "array", "items": {"enum": ["Security", "Availability", "Processing Integrity", "Confidentiality", "Privacy"]}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "description": "Quotes supporting entity, system, period, issue date, auditor, categories."}
      }
    },
    "subservice_orgs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "method", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "method": {"enum": ["carve-out", "inclusive"]},
          "services": {"type": "string"},
          "csocs": {"type": "array", "items": {"type": "string"}, "description": "Complementary subservice organization controls"},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "cuecs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "evidence"],
        "properties": {
          "text": {"type": "string"},
          "criteria": {"type": "array", "items": {"type": "string"}},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "controls": {
      "type": "array",
      "description": "Every control in the testing section. Do not skip, merge or summarize.",
      "items": {
        "type": "object",
        "required": ["id", "criteria", "description", "tests", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "criteria": {"type": "array", "items": {"type": "string"}, "description": "TSC IDs this control is listed under, e.g. CC6.1"},
          "description": {"type": "string"},
          "tests": {"type": "array", "items": {"$ref": "#/$defs/test"}},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "exceptions": {
      "type": "array",
      "description": "Every testing exception/deviation, even with a clean opinion. Empty array only if the report states none.",
      "items": {
        "type": "object",
        "required": ["control_id", "text", "evidence"],
        "properties": {
          "control_id": {"type": "string"},
          "text": {"type": "string"},
          "management_response": {"type": "string"},
          "evidence": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Optional free-text assertions destined for a client form (e.g. 'MFA enforced for production'). Each must cite controls/pages so specifics can be checked.",
      "items": {
        "type": "object",
        "required": ["field", "statement", "citations"],
        "properties": {
          "field": {"type": "string"},
          "statement": {"type": "string"},
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "control_ids": {"type": "array", "items": {"type": "string"}},
                "pdf_pages": {"type": "array", "items": {"type": "integer"}}
              }
            }
          }
        }
      }
    }
  }
}
